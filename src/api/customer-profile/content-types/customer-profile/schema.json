{
  "kind": "collectionType",
  "collectionName": "shop_customer_profiles",
  "info": {
    "singularName": "customer-profile",
    "pluralName": "customer-profiles",
    "displayName": "Customer Profile"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "legacyId": {
      "type": "integer",
      "unique": true,
      "min": 1,
      "private": true
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "profile"
    },
    "firstName": {
      "type": "string",
      "maxLength": 90
    },
    "lastName": {
      "type": "string",
      "maxLength": 90
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "displayName": {
      "type": "string",
      "maxLength": 90
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "shippingAddress": {
      "type": "component",
      "component": "profile.contact-address",
      "repeatable": false
    },
    "addresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::customer-address.customer-address",
      "mappedBy": "customer"
    },
    "orders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
      "mappedBy": "customer"
    }
  }
}
